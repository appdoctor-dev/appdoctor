# Copy to .dev.vars for local development. Never commit .dev.vars.

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Use a Stripe sandbox and a restricted key (rk_test_...). Needs write access to
# Products, Prices, Customers, Checkout Sessions, Customer Portal and Subscriptions,
# and read access to Charges, Invoices and Invoice Payments.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8787/auth/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

# npm run keys:generate -w @repo/api
LICENSE_SIGNING_KEY=

# Optional: enables "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Search Console queries on the admin's Analytics page. A Google Cloud
# service account's JSON key on one line; see scripts/search-console.sh.
GSC_SERVICE_ACCOUNT=
