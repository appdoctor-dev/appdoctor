{
  "name": "appdcotor",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "deploy": "turbo run deploy",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "db:generate": "npm run db:generate -w @repo/db",
    "db:migrate:local": "npm run db:migrate:local -w @repo/api",
    "db:migrate:remote": "npm run db:migrate:remote -w @repo/api",
    "auth:generate": "npm run auth:generate -w @repo/api",
    "keys:generate": "npm run keys:generate -w @repo/api",
    "stripe:listen": "npm run stripe:listen -w @repo/api"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.12.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
